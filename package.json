{
  "name": "astro-decap",
  "version": "0.4.1",
  "description": "Astro integration for configuring Decap CMS with optional GitHub OAuth endpoints",
  "keywords": [
    "astro-integration",
    "astro-component",
    "cms",
    "decap-cms"
  ],
  "author": "Nicolas Rio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicoRio42/astro-decap-cms.git"
  },
  "homepage": "https://github.com/NicoRio42/astro-decap-cms#readme",
  "bugs": {
    "url": "https://github.com/NicoRio42/astro-decap-cms/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "demo"
  ],
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./src/admin.astro": "./src/admin.astro",
    "./src/oauth/index.ts": "./src/oauth/index.ts",
    "./src/oauth/callback.ts": "./src/oauth/callback.ts"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "bun run build",
    "test": "bun test",
    "test:cold-cache": "bun test tests/cold-cache-cloudflare.test.js"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
